{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resource Monitor",
  "version": "0.1.0",
  "identifier": "com.leoerdman.rmon",
  "build": {
    "beforeDevCommand": "node ../../scripts/prepare-sidecar.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/prepare-sidecar.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resource Monitor",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.utilities",
    "shortDescription": "Кто съел память и можно ли его снять",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "binaries/rmon"
    ]
  }
}
